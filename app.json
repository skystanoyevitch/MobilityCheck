{
  "expo": {
    "name": "MobilityCheck",
    "slug": "MobilityCheck",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.internaldelegate.MobilityCheck",
      "infoPlist": {
        "NSCameraUsageDescription": "MobilityCheck needs camera access to analyze your body movements for mobility assessments.",
        "NSPhotoLibraryUsageDescription": "MobilityCheck needs photo library access to save assessment photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.internaldelegate.MobilityCheck"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
